# Obsidian — workspace é específico de cada máquina
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Plugins de terceiros — NÃO versionar o código (ver obsidian-plugins.json)
.obsidian/plugins/

# Placeholders do Obsidian na raiz (criados ao clicar em links não resolvidos)
/[A-Z]*-[A-Z0-9]*.md

# Estado interno do Obsidian MCP (transações/trash)
.obsidian-mcp/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Logs e temporários
*.log
gh-auth*.txt

# Node (build mobile / protótipo)
node_modules/

# Projeto Android do PROTÓTIPO (pertence à branch de teste do protótipo, não ao planejamento)
android/

# Godot (o jogo) — o game/.gitignore cobre .godot/ e game/android/
game/exports/
game/build/
*.apk
*.aab
