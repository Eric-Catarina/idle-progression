{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      },
      "obsidian": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "obsidian-mcp@2",
          "serve",
          "--vault",
          "idle=E:/projects/IdleProgression/IdleProgression"
        ]
      }
    }
  }
}
